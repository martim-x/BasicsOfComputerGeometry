		<region region-id="65" left="24" top="608.25" width="61.5" height="27.75" align-x="37.5" align-y="624" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
